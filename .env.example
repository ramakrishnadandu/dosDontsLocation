# Copy to .env and adjust. LocaGuide runs fully in demo/mock mode with just
# DATABASE_URL, REDIS_URL and JWT_SECRET set - every provider credential
# below is OPTIONAL. See docs/provider-architecture.md.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://locaguide:locaguide@localhost:5432/locaguide
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value-at-least-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

AI_CONFIG_PATH=./config/ai.yaml
POLICY_CONFIG_PATH=./config/policies.yaml

# --- Optional provider credentials (omit any/all to stay in mock/demo mode) ---

# Google Maps/Places (LocationProvider, ReviewProvider).
# How to get one: docs/google-api-setup.md
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Amazon Product Advertising API (ProductProvider) - not yet wired up, see
# packages/providers/src/products/AmazonProductProvider.ts
AMAZON_API_KEY=
AMAZON_API_SECRET=

# AI providers (AIProvider) - backend-only, never exposed to clients
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local/open-source model via Ollama (https://ollama.com) - no API key, runs
# entirely on-machine. Defaults assume `ollama serve` running locally with
# `ollama pull llama3.2:3b` already done. This is the DEFAULT AI provider
# (see config/ai.yaml) - only used if the Ollama server is actually
# reachable; otherwise AIRouter falls through to openai/anthropic/mock.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Object storage for community media uploads (section 46) - not yet wired up
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Only used by `npm run prisma:seed` to set the demo admin account password
SEED_ADMIN_PASSWORD=ChangeMe123!
